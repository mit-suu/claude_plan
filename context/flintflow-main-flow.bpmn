    </bpmn:userTask>
    <bpmn:subProcess id="SubAIFail" name="Handle AI Generation Failure" triggeredByEvent="true">
      <bpmn:startEvent id="AIFail_Start" name="AI error / timeout">
        <bpmn:outgoing>FA1</bpmn:outgoing>
        <bpmn:errorEventDefinition id="AIFail_ErrDef" errorRef="Err_AI" />
      </bpmn:startEvent>
      <bpmn:userTask id="Task_HandleAIFail" name="Show error, preserve accepted content">
        <bpmn:incoming>FA1</bpmn:incoming>
        <bpmn:outgoing>FA2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gw_Retry" name="Retry?">
        <bpmn:incoming>FA2</bpmn:incoming>
        <bpmn:outgoing>FA3</bpmn:outgoing>
        <bpmn:outgoing>FA4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="End_ReRun" name="Generation step re-run from last accepted content">
        <bpmn:incoming>FA3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="End_Paused" name="Project saved, author resumes later">
        <bpmn:incoming>FA4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="FA1" sourceRef="AIFail_Start" targetRef="Task_HandleAIFail" />
      <bpmn:sequenceFlow id="FA2" sourceRef="Task_HandleAIFail" targetRef="Gw_Retry" />
      <bpmn:sequenceFlow id="FA3" name="Retry now" sourceRef="Gw_Retry" targetRef="End_ReRun" />
      <bpmn:sequenceFlow id="FA4" name="Resume later" sourceRef="Gw_Retry" targetRef="End_Paused" />
    </bpmn:subProcess>
    <bpmn:userTask id="T26" name="26. Run Quality Check">
